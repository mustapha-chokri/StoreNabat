# ==============================================================================
# Nabat Al Atlas — Moroccan Multi-Tenant E-Commerce Platform Environment Config
# ==============================================================================

# App Core
NODE_ENV=development
APP_URL=http://localhost:3000
SINGLE_STORE_MODE=true
DEFAULT_TENANT_SLUG=nabat-al-atlas

# PostgreSQL Databases
# Admin/Migration connection (used ONLY by CLI migrations, seeding, and tenant provisioning)
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nabat_atlas
# Runtime connection using restricted NOBYPASSRLS role (enforces PostgreSQL Row-Level Security)
DATABASE_URL=postgresql://app_runtime:CHANGE_ME_RUNTIME@localhost:5432/nabat_atlas
# Optional separate Control Plane DB URL (defaults to DATABASE_URL when omitted)
CONTROL_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nabat_atlas

# Security & Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_char_hex_random_secret_for_sessions_and_signing
TENANT_ENCRYPTION_KEY=replace_with_64_char_hex_aes_256_gcm_master_key

# Redis & Background Jobs (Optional in local dev, REQUIRED in production)
REDIS_URL=redis://localhost:6379

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
# S3-Compatible Settings (when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Default SMTP Fallback (Storefront also supports per-store SMTP in Admin Dashboard)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nabat Al Atlas <no-reply@nabatalatlas.ma>"

# Initial Admin Seed (Only used during db:seed)
SEED_ADMIN_EMAIL=admin@nabatalatlas.ma
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="مدير متجر نبات الأطلس"

